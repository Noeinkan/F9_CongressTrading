# Copy this file to `.env` in the repo root and fill in values.

# `.env` is gitignored — never commit secrets.



POLYGON_API_KEY=

OPENFIGI_API_KEY=



# Optional: speed up ticker API calls (lower = faster; too low may trigger HTTP 429).

# POLYGON_MIN_INTERVAL_SECONDS=0.2

# OPENFIGI_MIN_INTERVAL_SECONDS=0.25



# Re-resolve: skip Polygon GET /v3/reference/tickers/{ticker} (issuer detail); faster, sector/SIC from heuristics only.

# CONGRESS_SKIP_POLYGON_TICKER_DETAILS=1



# Re-resolve: disable batched OpenFIGI (100 names per POST); only for debugging.

# CONGRESS_DISABLE_RE_RESOLVE_OPENFIGI_BATCH=1



# Re-resolve: prefetch all distinct assets before updating transactions (slower; default off).

# CONGRESS_RE_RESOLVE_TICKERS_BULK=0



# Note: name resolution uses OpenFIGI /v3/search (one request per asset). OPENFIGI_BATCH_SIZE is unused.



# Optional: name-match thresholds (defaults are more permissive than legacy 88/85).

# POLYGON_FUZZY_MIN_SCORE=82

# OPENFIGI_FUZZY_MIN_SCORE=78



# Optional: restrict OpenFIGI name mapping to Common Stock only (narrower; can miss ADRs).

# OPENFIGI_NAME_STRICT_COMMON_STOCK=0



# App auth (set on VPS; leave APP_PASSWORD unset for open local dev).

# NOTE: these were called DASHBOARD_USERNAME / DASHBOARD_PASSWORD under the old

# Streamlit dashboard. The FastAPI app reads the APP_* names ONLY — a server

# still carrying the DASHBOARD_* names has no login gate at all, whatever it

# looks like. Check /api/health: "auth_required" must be true.

# Real values belong in the gitignored .env, never here.

# APP_USERNAME=you@example.com

# APP_PASSWORD=

# APP_SESSION_SECRET=

# APP_SESSION_COOKIE=f9_session

# APP_SESSION_HTTPS_ONLY=0

# APP_SESSION_MAX_AGE=1209600

# APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173



# API server (python -m src.api)

# API_SERVER_ADDRESS=127.0.0.1

# API_SERVER_PORT=9001

# API_RELOAD=1



# Price cache (daily bars for P&L / return columns)

# PRICE_CACHE_SOURCE=yahoo

# YAHOO_MIN_INTERVAL_SECONDS=0.3

# PRICE_CACHE_PARALLEL_WORKERS=4


# ---------------------------------------------------------------------------

# Public demo mode (docs/DEMO.md). Default OFF everywhere, including production.

# DEMO_MODE=1 makes this process a read-only demo: every write to /api/* is

# refused and POST /api/demo/session mints the one-click visitor session.

# Unset or false and the demo route 404s and nothing else changes.

# DEMO_MODE=0

# DEMO_USERNAME=demo

# DEMO_PASSWORD=demo

# DEMO_SNAPSHOT_DATE=2026-09-12

# DEMO_SOURCE_URL=https://noeinsolutions.com/builds.html



# Which SQLite file this process serves. Unset = data/db/congress_trades.sqlite.

# The demo points it at the unpacked frozen snapshot instead, so the live

# tracker and the public demo can run from one checkout.

# CONGRESS_DB_PATH=data/db/demo-snapshot.sqlite

# --- Notifiche Telegram (scripts/nightly_ingest.sh) -------------------------

# Senza queste due, i comandi notify-* non inviano nulla e lo dicono nel log.

# Stesso nome usato dagli altri tracker sullo stesso server: un bot puo servirli tutti.

# TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID=



# Interruttore generale (default: attivo se token e chat id sono presenti).

# CONGRESS_NOTIFY_ENABLED=1



# Indirizzo pubblico della dashboard: nomi e ticker nei messaggi diventano link

# alle sue pagine. Senza, i messaggi escono uguali ma senza link.

# CONGRESS_DASHBOARD_URL=https://congress.noeinsolutions.com



# Soglie di segnalazione. Confrontate sul *minimo* dichiarato: una fascia

# "$100,001 - $250,000" supera 100000, una "$50,001 - $100,000" no.

# Le operazioni grandi contano solo su azioni ed ETF quotati: titoli di Stato,

# obbligazioni e fondi restano fuori a qualunque importo.

# CONGRESS_NOTIFY_LARGE_TRADE_USD=100000

# CONGRESS_NOTIFY_OPTION_TRADE_USD=15000

# CONGRESS_NOTIFY_CLUSTER_MIN_MEMBERS=3

# CONGRESS_NOTIFY_CLUSTER_WINDOW_DAYS=45

# CONGRESS_NOTIFY_LATE_FILING_DAYS=45

# Deposito piu vecchio di cosi = caricato ma mai segnalato (0 = nessun limite).

# Evita che un backfill (es. il primo download Senate, dal 2023) arrivi come notizia.

# CONGRESS_NOTIFY_MAX_FILING_AGE_DAYS=30



# Forma del messaggio: quanti eventi elencare, e oltre quante righe nuove

# trattare la notte come un batch massivo (solo i piu rilevanti in elenco).

# CONGRESS_NOTIFY_MAX_EVENTS=12

# CONGRESS_NOTIFY_FLOOD_THRESHOLD=250



# Digest settimanale: 0 = lunedi ... 6 = domenica. Il comando si auto-limita a

# quel giorno, quindi puo essere chiamato ogni notte.

# CONGRESS_NOTIFY_DIGEST_WEEKDAY=0

# Giorni senza righe nuove dopo i quali il digest segnala la pipeline ferma.

# CONGRESS_NOTIFY_STALE_INGEST_DAYS=10
