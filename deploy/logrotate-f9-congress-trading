/var/log/f9-congress-trading/ingest.log {
    # Daily ingest log: one run per night, a few hundred lines.
    # Keep 30 days, gzip older rotations, recreate the live file with
    # predictable perms so the cron's `>>` has a destination.
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    # The ingest runs as 'deploy', so the log and its directory belong to it;
    # `su` stops logrotate refusing a directory not owned by root.
    su deploy deploy
    create 0640 deploy deploy
    dateext
    dateformat -%Y%m%d
}
